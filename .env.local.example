# ============================================================
# Client & Server Next.js Environment Variables
# ============================================================

# Supabase (Publicly accessible keys for client & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional Site URL override (defaults to current origin or Vercel URL)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Gemini AI (server-only — do NOT prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key

# ============================================================
# Supabase Edge Function Secrets (Set in Supabase Dashboard / CLI)
# DO NOT put these in client-side Next.js environment files!
# Set via: supabase secrets set KEY=VALUE
# ============================================================
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=no-reply@your-verified-domain.com
# RESEND_FROM_NAME=Gluvia
# APP_URL=https://your-domain.com
# SEND_EMAIL_HOOK_SECRET=your-random-hook-secret
# CRON_SECRET=your-random-cron-secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
